# Copy to .env (gitignored). Used by `npm run send` and `npm run export`.

# --- Cloudflare D1 (subscriber database) ---
# Account ID: Cloudflare dashboard → Workers & Pages → right sidebar.
CF_ACCOUNT_ID=
# From `npx wrangler d1 create follow` (also in worker/wrangler.jsonc).
D1_DATABASE_ID=
# API token with ONLY "Account → D1 → Edit" on this account. Never commit it.
CF_API_TOKEN=

# --- Email ---
MAIL_PROVIDER=resend
# Resend API key with "Sending access" restricted to your sending domain.
RESEND_API_KEY=
# Must be on a domain verified with your provider, e.g. a subdomain of your blog.
MAIL_FROM="Your Name <you@news.example.com>"
# Where replies go (any inbox, e.g. your personal address). Optional.
MAIL_REPLY_TO=

# --- Links ---
# Public URL of the deployed Worker (used for unsubscribe links).
WORKER_URL=https://follow.example.com
# Shown in the email footer.
SITE_NAME="My Blog"

# --- Local development only ---
# D1_LOCAL=1 reads the SQLite file `npm run dev` uses instead of remote D1.
# D1_LOCAL=1
